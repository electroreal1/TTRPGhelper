<Window x:Class="TTRPGhelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TTRPGhelper"
        mc:Ignorable="d"
        Title="TTRPG Helper" Height="800" Width="1050"
        Background="{DynamicResource AppBackground}"
        FontFamily="Cascadia Code">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="AppForeground" Color="#1C1E21"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E4E6EB"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1877F2"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20" TextElement.Foreground="{DynamicResource AppForeground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="Character Name:" Margin="0,0,5,0"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,15,0" FontWeight="Bold"/>

                <Label Content="Pathway:" Margin="0,0,5,0"/>
                <ComboBox SelectedItem="{Binding SelectedPathway}" Width="100" VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="5,2" FontSize="14">
                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Darkness</System:String>
                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Death</System:String>
                </ComboBox>

                <Label Content="Sequence:" Margin="0,0,5,0"/>
                <ComboBox SelectedItem="{Binding CurrentSequence}" Width="50" VerticalContentAlignment="Center" Margin="0,0,15,0" Padding="5,2" FontSize="14">
                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">9</System:Int32>
                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">8</System:Int32>
                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">7</System:Int32>
                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">6</System:Int32>
                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">5</System:Int32>
                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">4</System:Int32>
                </ComboBox>

                <Button Content="Apply Stats" Click="applyPathway_Click" Padding="15,5" FontWeight="Bold" FontSize="14" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                             
                <CheckBox Content="Dark Mode" VerticalAlignment="Center" Margin="25,0,0,0" Checked="DarkMode_Checked" Unchecked="DarkMode_Unchecked" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,15">

            <TabItem Header="Main Sheet">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20" Margin="0,10,0,15" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,25,0">
                                <TextBlock Text="Base Attributes" FontSize="16" FontWeight="Bold" Margin="5,0,0,15" Foreground="{DynamicResource AccentColor}"/>

                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,5,15,5">
                                        <Label Content="HP:" Width="95"/>
                                        <TextBox Text="{Binding CurrentHP, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                        <Label Content="/" Padding="5,0"/>
                                        <TextBox Text="{Binding MaxHP, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="5,5,15,5">
                                        <Label Content="SHP:" Width="95"/>
                                        <TextBox Text="{Binding CurrentSHP, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                        <Label Content="/" Padding="5,0"/>
                                        <TextBox Text="{Binding MaxSHP, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="5,5,15,5">
                                        <Label Content="Spirituality:" Width="95"/>
                                        <TextBox Text="{Binding CurrentSpirituality, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                        <Label Content="/" Padding="5,0"/>
                                        <TextBox Text="{Binding MaxSpirituality, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="5,5,15,5">
                                        <Label Content="Armor (AC):" Width="95"/>
                                        <TextBox Text="{Binding AC, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="5,5,15,5">
                                        <Label Content="Movement:" Width="95"/>
                                        <TextBox Text="{Binding Movement, UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="Portrait" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="{DynamicResource AccentColor}"/>
                                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="2" Width="130" Height="130" CornerRadius="8" Background="{DynamicResource AppBackground}" ClipToBounds="True">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                </Border>
                                <Button Content="Upload Image" Click="UploadImage_Click" Margin="0,15,0,0" Padding="15,6" Background="Transparent" BorderBrush="{DynamicResource CardBorder}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Active Pathway Abilities" FontSize="18" FontWeight="Bold" Margin="5,0,0,15" Foreground="{DynamicResource AccentColor}"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
                                <ItemsControl ItemsSource="{Binding ActiveAbilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="15" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Training &amp; Stats">
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20" Margin="0,10,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Physical &amp; Core XP" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentColor}"/>

                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Strength XP:" Width="110"/>
                                <TextBox Text="{Binding StrengthXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding StrLevel, StringFormat='{} (Lvl {0})'}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Dexterity XP:" Width="110"/>
                                <TextBox Text="{Binding DexterityXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding DexLevel, StringFormat='{} (Lvl {0})'}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Constit. XP:" Width="110"/>
                                <TextBox Text="{Binding ConstitutionXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding ConLevel, StringFormat='{} (Lvl {0})'}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Exercise XP:" Width="110"/>
                                <TextBox Text="{Binding ExerciseXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding ExerciseLevel, StringFormat='{} (Lvl {0})'}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Move XP:" Width="110"/>
                                <TextBox Text="{Binding MovementXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding MoveLevel, StringFormat='{} (Lvl {0})'}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Pathway Stats" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource AccentColor}"/>

                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Secrecy XP:" Width="110"/>
                                <TextBox Text="{Binding SecrecyXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding TotalSecrecy, StringFormat='{} (Total {0})'}" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Speech XP:" Width="110"/>
                                <TextBox Text="{Binding SpeechXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding TotalSpeech, StringFormat='{} (Total {0})'}" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Autopsy XP:" Width="110"/>
                                <TextBox Text="{Binding AutopsyXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding TotalAutopsy, StringFormat='{} (Total {0})'}" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,15,10">
                                <Label Content="Intimidate XP:" Width="110"/>
                                <TextBox Text="{Binding IntimidationXP, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <TextBlock Text="{Binding TotalIntimidation, StringFormat='{} (Total {0})'}" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Backstory &amp; Traits">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20" Margin="0,0,10,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Backstory &amp; Lore" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource AccentColor}"/>
                            <TextBox Grid.Row="1" Text="{Binding Backstory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20" Margin="10,0,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Personality &amp; Quirks" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource AccentColor}"/>
                            <TextBox Grid.Row="1" Text="{Binding Personality, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Session Notes">
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="20" Margin="0,10,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Scratchpad &amp; Inventory" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource AccentColor}"/>
                        <TextBox Grid.Row="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="15" FontSize="16"/>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">

            <Button Content="Import" Click="Import_Click" Padding="20,12" FontSize="14" FontWeight="Bold" Background="#6C757D" Foreground="White" BorderThickness="0" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Export" Click="Export_Click" Padding="20,12" FontSize="14" FontWeight="Bold" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Quick Save" Click="Save_Click" Padding="25,12" FontSize="14" FontWeight="Bold" Background="#28A745" Foreground="White" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</Window>